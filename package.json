{
	"name": "keyv-aerospike",
	"version": "2.0.0-beta.0",
	"description": "Aerospike storage adapter for Keyv",
	"type": "module",
	"license": "MIT",
	"author": "Anton Vozghrin <anton.vozgrin@gmail.com>",
	"homepage": "https://github.com/v-anton/keyv-aerospike#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/v-anton/keyv-aerospike.git"
	},
	"bugs": {
		"url": "https://github.com/v-anton/keyv-aerospike/issues"
	},
	"keywords": [
		"keyv",
		"aerospike",
		"storage",
		"adapter",
		"key-value",
		"cache",
		"database",
		"ttl"
	],
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"files": ["dist"],
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "tsdown",
		"prepublishOnly": "npm run build",
		"dev": "tsdown --watch",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:services:start": "docker compose up -d aerospike",
		"test:services:stop": "docker compose down",
		"test:docker": "docker compose run --rm test"
	},
	"dependencies": {
		"hookified": "^3.0.1"
	},
	"peerDependencies": {
		"aerospike": "^5.0.0 || ^6.0.0",
		"keyv": "^6.0.0-beta.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@keyv/test-suite": "^6.0.0-beta.4",
		"@types/node": "^22.15.17",
		"aerospike": "^6.7.1",
		"keyv": "^6.0.0-beta.4",
		"tsdown": "^0.11.9",
		"typescript": "^5.8.3",
		"vitest": "^3.1.3"
	}
}
